PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/medical_vault
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Set this to the URL phones use to open the app (for example http://192.168.1.25:5173).
# In local Vite development the QR uses the browser's current origin automatically.
# PUBLIC_APP_URL=http://192.168.1.25:5173
ML_SERVICE_URL=http://127.0.0.1:8001
MAX_UPLOAD_MB=10
MAX_FOOD_IMAGE_MB=10
# Gemini is the default food-photo vision provider. Create a key at https://aistudio.google.com/app/apikey.
FOOD_VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FOOD_MODEL=gemini-3.5-flash-lite
# Optional alternate provider: set FOOD_VISION_PROVIDER=openai and configure these instead.
OPENAI_API_KEY=
OPENAI_FOOD_MODEL=gpt-4o-mini
# Optional USDA FoodData Central key. Without it, the low-limit DEMO_KEY is used.
FDC_API_KEY=

AUTO_VERIFY_DOCTORS=false
# Optional OCR/document-AI microservice. It should expose POST /extract-report and return structured JSON.
# DOCUMENT_AI_URL=http://localhost:8002
